{
  "name": "dsh-vsc",
  "displayName": "DSH Bridge",
  "description": "DeepSeek Harness (DSH) in VS Code: native sidebar panel + editor bridge for the local AI agent 鈥?a pure protocol client, no second server.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "ai",
    "agent",
    "ai-agent",
    "local-ai",
    "vscode",
    "vscode-extension",
    "vs-code",
    "ide",
    "code-assistant",
    "sidebar",
    "protocol-client",
    "harness"
  ],
  "version": "1.4.0",
  "publisher": "local",
  "license": "MIT",
  "author": "zhibailu (original project); Najabom (fork maintainer)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Najabom/dsh_vsc_refresh.git"
  },
  "homepage": "https://github.com/Najabom/dsh_vsc_refresh",
  "bugs": {
    "url": "https://github.com/Najabom/dsh_vsc_refresh/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pure bridge to the local DSH harness (127.0.0.1:3080): panel, status bar, editor context. No workspace code is executed."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-right",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh-right": [
        {
          "type": "webview",
          "id": "dsh.sidebar.right",
          "name": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openSidebar",
        "title": "%dsh.command.openSidebar%"
      },
      {
        "command": "dsh.start",
        "title": "%dsh.command.start%"
      },
      {
        "command": "dsh.stop",
        "title": "%dsh.command.stop%"
      },
      {
        "command": "dsh.refreshStatus",
        "title": "%dsh.command.refreshStatus%"
      },
      {
        "command": "dsh.openWebView",
        "title": "%dsh.command.openWebView%"
      },
      {
        "command": "dsh.askSelection",
        "title": "%dsh.command.askSelection%",
        "enablement": "editorHasSelection"
      },
      {
        "command": "dsh.reviewChanges",
        "title": "%dsh.command.reviewChanges%"
      },
      {
        "command": "dsh.reloadPanel",
        "title": "%dsh.command.reloadPanel%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "dsh.reviewChanges"
        },
        {
          "command": "dsh.reloadPanel"
        }
      ]
    },
    "configuration": {
      "title": "DSH Bridge",
      "properties": {
        "dshVsc.url": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "%dsh.config.url%"
        },
        "dshVsc.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.autoStart%"
        },
        "dshVsc.followAgentEdits": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.followAgentEdits%"
        },
        "dshVsc.autoFixWorkspaceAcl": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.autoFixWorkspaceAcl%"
        },
        "dshVsc.companion": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.companion%"
        },
        "dshVsc.statusBarEntry": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.statusBarEntry%"
        },
        "dshVsc.nativeWebAuth": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.nativeWebAuth%"
        },
        "dshVsc.dshUpdateChannel": {
          "type": "string",
          "enum": [
            "auto",
            "stable",
            "next",
            "alpha"
          ],
          "default": "auto",
          "description": "%dsh.config.dshUpdateChannel%",
          "enumDescriptions": [
            "%dsh.config.dshUpdateChannel.auto%",
            "%dsh.config.dshUpdateChannel.stable%",
            "%dsh.config.dshUpdateChannel.next%",
            "%dsh.config.dshUpdateChannel.alpha%"
          ]
        },
        "dshVsc.notifyTurnFailures": {
          "type": "boolean",
          "default": true,
          "description": "%dsh.config.notifyTurnFailures%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.overlay.json --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "record-pristine": "node scripts/record-pristine.mjs",
    "package": "node esbuild.js && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "ws": "^8.22.0"
  }
}
