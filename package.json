{
  "name": "dsh-vsc",
  "displayName": "DSH Bridge",
  "description": "DeepSeek Harness (DSH) in VS Code: native sidebar panel + editor bridge for the local AI agent — a pure protocol client, no second server.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "ai",
    "agent",
    "ai-agent",
    "local-ai",
    "vscode",
    "vscode-extension",
    "vs-code",
    "ide",
    "code-assistant",
    "sidebar",
    "protocol-client",
    "harness"
  ],
  "version": "0.3.21",
  "publisher": "local",
  "license": "MIT",
  "author": "zhibailu (original project); Najabom (fork maintainer)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Najabom/dsh_vsc_refresh.git"
  },
  "homepage": "https://github.com/Najabom/dsh_vsc_refresh",
  "bugs": {
    "url": "https://github.com/Najabom/dsh_vsc_refresh/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pure bridge to the local DSH harness (127.0.0.1:3080): panel, status bar, editor context. No workspace code is executed."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-right",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh-right": [
        {
          "type": "webview",
          "id": "dsh.sidebar.right",
          "name": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openSidebar",
        "title": "DSH: Open Sidebar"
      },
      {
        "command": "dsh.start",
        "title": "DSH: Start Web Harness"
      },
      {
        "command": "dsh.stop",
        "title": "DSH: Stop Auto-started Harness"
      },
      {
        "command": "dsh.refreshStatus",
        "title": "DSH: Refresh Connection Status"
      },
      {
        "command": "dsh.openWebView",
        "title": "DSH: Open Web GUI (advanced)"
      },
      {
        "command": "dsh.askSelection",
        "title": "DSH: Ask about selection",
        "enablement": "editorHasSelection"
      },
      {
        "command": "dsh.reviewChanges",
        "title": "DSH: Review Agent Changes"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "dsh.reviewChanges"
        }
      ]
    },
    "configuration": {
      "title": "DSH Bridge",
      "properties": {
        "dshVsc.url": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "Base URL of the DSH harness this extension talks to. Default 3080 = the web GUI's harness: the extension connects as a shared client and never starts or kills it. If nothing answers there, the extension auto-starts its own instance (recorded in %TEMP%\\dsh-vsc-harness.pid, stopped when VS Code exits) with the runtime overlay that bypasses dsh 0.1.7's launch-token auth. Also honors DSH_WEB_URL."
        },
        "dshVsc.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `dsh web` automatically when no harness is reachable at the configured URL."
        },
        "dshVsc.followAgentEdits": {
          "type": "boolean",
          "default": true,
          "description": "DSH 修改文件时自动在编辑器打开对应文件，并把光标定位到第一个修改行（跟随 agent 编辑：预览标签、不抢焦点，磁盘更新实时刷新）。覆盖直接写入/编辑工具与代码执行内的嵌套调用（tools.write/edit 等）；无法识别路径的 shell 命令（如 pwsh Set-Content）除外。"
        },
        "dshVsc.autoFixWorkspaceAcl": {
          "type": "boolean",
          "default": true,
          "description": "打开或切换工作区时，自动修复 DSH workspace-write 沙箱所需的目录权限（授予当前用户完全控制）；无法自动修复时提示以管理员身份修复一次。关闭后沙箱在权限不完整的工作区（如从其他电脑拷贝的文件夹）中会启动失败。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.overlay.json --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "ws": "^8.22.0"
  }
}
